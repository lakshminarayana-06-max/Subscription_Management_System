<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Product Template Form -->
    <record id="view_product_template_form_brightloop" model="ir.ui.view">
        <field name="name">product.template.form.brightloop</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="is_subscription_product"/>
                    <label for="is_subscription_product"/>
                </span>
            </xpath>
        </field>
    </record>

    <!-- Product Product (Variant) Tree View -->
    <record id="view_brightloop_product_variant_tree" model="ir.ui.view">
        <field name="name">brightloop.product.variant.tree</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <tree string="Product Variants" sample="1">
                <field name="default_code" string="Product ID"/>
                <field name="name" string="Product Name"/>
                <field name="brand_name" string="Brand / Edition"/>
                <field name="lst_price" string="Base Price (₹)" widget="monetary"/>
                <field name="brand_price_adjustment" string="Brand Adjustment (₹)" widget="monetary"/>
                <field name="final_variant_price" string="Final Variant Price (₹)" widget="monetary"/>
                <field name="standard_price" string="Cost Price (₹)" widget="monetary"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Action for Products (Product Templates) -->
    <record id="action_brightloop_products" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('is_subscription_product', '=', True)]</field>
        <field name="context">{'default_is_subscription_product': True}</field>
    </record>

    <!-- Action for Product Variants -->
    <record id="action_brightloop_product_variants" model="ir.actions.act_window">
        <field name="name">Product Variants</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_brightloop_product_variant_tree"/>
    </record>
</odoo>
