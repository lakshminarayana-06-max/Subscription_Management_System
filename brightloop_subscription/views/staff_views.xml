<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Staff Management Tree View -->
    <record id="view_brightloop_staff_tree" model="ir.ui.view">
        <field name="name">brightloop.staff.tree</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <tree string="Staff Team">
                <field name="name"/>
                <field name="login" string="Email"/>
                <field name="brightloop_role" widget="badge" 
                       decoration-danger="brightloop_role == 'admin'"
                       decoration-primary="brightloop_role == 'staff'"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Action for Staff Management -->
    <record id="action_brightloop_staff" model="ir.actions.act_window">
        <field name="name">Staff Management</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_brightloop_staff_tree"/>
        <field name="domain">[('share', '=', False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add an internal staff team member.
            </p>
            <p>
                Only administrators can create and assign internal staff roles.
            </p>
        </field>
    </record>
</odoo>
