<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quotation Template Tree -->
    <record id="view_brightloop_quotation_template_tree" model="ir.ui.view">
        <field name="name">brightloop.quotation.template.tree</field>
        <field name="model">brightloop.quotation.template</field>
        <field name="arch" type="xml">
            <tree string="Quotation Templates">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="validity_days"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Quotation Template Form -->
    <record id="view_brightloop_quotation_template_form" model="ir.ui.view">
        <field name="name">brightloop.quotation.template.form</field>
        <field name="model">brightloop.quotation.template</field>
        <field name="arch" type="xml">
            <form string="Quotation Template">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Template Name"/>
                        <h1><field name="name" placeholder="e.g. Enterprise Onboarding Pack"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="plan_id"/>
                            <field name="validity_days"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Predefined Products &amp; Variants">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price" widget="monetary"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Default Terms">
                            <field name="note" placeholder="Standard quotation terms..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_brightloop_quotation_templates" model="ir.actions.act_window">
        <field name="name">Quotation Templates</field>
        <field name="res_model">brightloop.quotation.template</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
