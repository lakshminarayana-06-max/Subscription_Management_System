<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Recurring Invoice Generation Cron -->
        <record id="ir_cron_subscription_recurring_billing" model="ir.cron">
            <field name="name">Brightloop: Recurring Invoice Generation</field>
            <field name="model_id" ref="model_brightloop_subscription"/>
            <field name="state">code</field>
            <field name="code">model.cron_recurring_billing()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 2. Daily Subscription Expiry & Auto-Close Check -->
        <record id="ir_cron_subscription_check_expiries" model="ir.cron">
            <field name="name">Brightloop: Automatic Subscription Expiry &amp; Closure</field>
            <field name="model_id" ref="model_brightloop_subscription"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_expiries()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 3. Upcoming Renewal Reminders (7-day advance notice) -->
        <record id="ir_cron_subscription_renewal_reminders" model="ir.cron">
            <field name="name">Brightloop: Upcoming Renewal Notifications</field>
            <field name="model_id" ref="model_brightloop_subscription"/>
            <field name="state">code</field>
            <field name="code">model.cron_renewal_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 4. Plan End-Date Auto-Close Check -->
        <record id="ir_cron_plan_auto_close" model="ir.cron">
            <field name="name">Brightloop: Plan End Date Auto-Close</field>
            <field name="model_id" ref="model_brightloop_subscription_plan"/>
            <field name="state">code</field>
            <field name="code">model.cron_auto_close_plans()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 5. Discount Expiry & Usage Validation Check -->
        <record id="ir_cron_discount_expiry" model="ir.cron">
            <field name="name">Brightloop: Discount Expiry &amp; Usage Validation</field>
            <field name="model_id" ref="model_brightloop_discount_rule"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_discount_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Sequence for Subscriptions -->
        <record id="seq_brightloop_subscription" model="ir.sequence">
            <field name="name">Subscription Reference Sequence</field>
            <field name="code">brightloop.subscription</field>
            <field name="prefix">SUB/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Quotations -->
        <record id="seq_brightloop_quotation" model="ir.sequence">
            <field name="name">Quotation Reference Sequence</field>
            <field name="code">brightloop.quotation</field>
            <field name="prefix">QT/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
